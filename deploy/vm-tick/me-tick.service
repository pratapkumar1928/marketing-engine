[Unit]
Description=marketing-engine: trigger the GitHub `run` workflow (workflow_dispatch, dry_run=auto)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# GH_TOKEN = fine-grained PAT, this repo only, Actions: read and write ONLY (can trigger runs, cannot change code)
EnvironmentFile=/etc/marketing-engine/tick.env
ExecStart=/usr/bin/curl -fsS --max-time 30 -X POST \
  -H "Authorization: Bearer ${GH_TOKEN}" -H "Accept: application/vnd.github+json" \
  -d '{"ref":"main","inputs":{"dry_run":"auto"}}'   https://api.github.com/repos/pratapkumar1928/marketing-engine/actions/workflows/run.yml/dispatches
